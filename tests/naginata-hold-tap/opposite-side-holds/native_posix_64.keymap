#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <behaviors.dtsi>

/ {
    behaviors {
        ng_mt_test: ng_mt_test {
            compatible = "zmk,behavior-naginata-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            shortcut-binding = <&kp>;
            tapping-term-ms = <100>;
            hold-trigger-key-positions = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &ng_mt_test RGUI J  &kp X
                &kp K                &kp Y
            >;
        };
    };
};

&kscan {
    events = <
        ZMK_MOCK_PRESS(0, 0, 10)
        ZMK_MOCK_PRESS(0, 1, 150)
        ZMK_MOCK_RELEASE(0, 1, 10)
        ZMK_MOCK_RELEASE(0, 0, 10)
    >;
};
