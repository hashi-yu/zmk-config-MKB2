#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <behaviors.dtsi>
#include <behaviors/naginata.dtsi>

/ {
    behaviors {
        ng_key_test: ng_key_test {
            compatible = "zmk,behavior-naginata-key";
            #binding-cells = <1>;
            binding = <&ng>;
            shortcut-binding = <&kp>;
            shortcut-key-position = <2>;
            shortcut-keycode = <BSPC>;
        };

        ng_mt_test: ng_mt_test {
            compatible = "zmk,behavior-naginata-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&ng>;
            shortcut-binding = <&kp>;
            tapping-term-ms = <100>;
            hold-trigger-key-positions = <1 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &ng_mt_test RGUI J  &ng_key_test W
                &ng_key_test U       &kp Y
            >;
        };
    };
};

&kscan {
    events = <
        ZMK_MOCK_PRESS(0, 0, 10)
        ZMK_MOCK_PRESS(0, 1, 150)
        ZMK_MOCK_RELEASE(0, 1, 10)
        ZMK_MOCK_RELEASE(0, 0, 10)

        ZMK_MOCK_PRESS(0, 0, 100)
        ZMK_MOCK_PRESS(1, 0, 150)
        ZMK_MOCK_RELEASE(1, 0, 10)
        ZMK_MOCK_RELEASE(0, 0, 10)
    >;
};
