// #include <layout_shift.dtsi>

#include <layout_shift_kp_override.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/naginata.dtsi>

#define DEF 0
#define NAGI 1
#define NUM 2
#define NAGI_NUM 3
#define MATH 4
#define SYM 5
#define ARROW 6
#define BT 7

&lt {
    quick-tap-ms = <150>;
    flavor = "tap-preferred";
};

&mt {
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    flavor = "tap-preferred";
};

/ {
    macros {
        ng_on: ng_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANGUAGE_1 &kp INTERNATIONAL_4 &to NAGI>;
            label = "NG_ON";
        };

        ng_off: ng_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANGUAGE_2 &kp INTERNATIONAL_5 &to DEF>;
            label = "NG_OFF";
        };

        ng_space_key: ng_space_key {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&ng SPACE &macro_param_1to1>,
                <&macro_tap>,
                <&ng MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&ng SPACE>;
            label = "NG_SPACE_KEY";
        };

        deg: deg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp LS(LA(N8)) &kp LS(C)>;
            label = "DEG";
        };

        kakko1: kakko1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS>;
            label = "KAKKO1";
        };

        kakko2: kakko2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN &kp GREATER_THAN>;
            label = "KAKKO2";
        };

        kakko3: kakko3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET>;
            label = "KAKKO3";
        };

        kakko4: kakko4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE>;
            label = "KAKKO4";
        };

        app_next: app_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LGUI>;

            label = "APP_NEXT";
        };

        app_prev: app_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LSHFT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LGUI &kp LSHFT>;

            label = "APP_PREV";
        };

        space_key: space_key {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp SPACE &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp SPACE>;

            label = "SPACE_KEY";
        };
    };

    behaviors {
        ng_mt: ng_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "NG_MT";
            bindings = <&kp>, <&ng>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        ng_num: ng_num {
            compatible = "zmk,behavior-hold-tap";
            label = "NG_NUM";
            bindings = <&mo>, <&ng>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 11 23 35 45 43 44 42 41>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        ng_lt: ng_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "NG_LT";
            bindings = <&mo>, <&ng>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
        };

        ng_sands: ng_sands {
            compatible = "zmk,behavior-hold-tap";
            label = "NG_SANDS";
            bindings = <&mo>, <&ng>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 45 44 43 40 39 0 12 24 36 38 37>;
        };

        num: num {
            compatible = "zmk,behavior-hold-tap";
            label = "NUM";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 11 23 35 45 43 44 42 41>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        arrow: arrow {
            compatible = "zmk,behavior-hold-tap";
            label = "ARROW";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <1000>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 45 44 43 0 12 24 36 37 38 39 40>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
        };

        sands: sands {
            compatible = "zmk,behavior-hold-tap";
            label = "SANDS";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 45 44 43 40 39 0 12 24 36 38 37>;
        };

        enc_cw: enc_cw {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RIGHT>, <&kp DOWN>;

            mods = <(MOD_LALT|MOD_RALT)>;
        };

        enc_ccw: enc_ccw {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT>, <&kp UP>;

            mods = <(MOD_LALT|MOD_RALT)>;
        };

        enc_app: enc_app {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&app_next>, <&app_prev>;
        };

        enc_cursor: enc_cursor {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&enc_ccw>, <&enc_cw>;

            tap-ms = <6>;
            label = "ENC_CURSOR";
        };

        num_mod: num_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "NUM_MOD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <14 15 16>;
        };
    };

    combos {
        compatible = "zmk,combos";

        rome {
            bindings = <&ng_off>;
            key-positions = <40 39>;
        };

        kana {
            bindings = <&ng_on>;
            key-positions = <41 42>;
        };

        naginata_off {
            bindings = <&ng_off>;
            key-positions = <16 17>;
            layers = <NAGI>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        naginata_num {
            if-layers = <NAGI NUM>;
            then-layer = <NAGI_NUM>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Def";
            bindings = <
&kp ESCAPE  &kp Q        &kp W           &kp E             &kp R               &kp T          &kp Y        &kp BSPC             &kp I              &kp O            &kp P          &kp LS(LA(LC(F)))
&kp TAB     &mt LCTRL A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LEFT_COMMAND F  &kp G          &kp H        &mt RIGHT_COMMAND J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &mt RCTRL U     &kp F3
&kp LSHFT   &kp Z        &kp X           &kp C             &kp V               &kp B          &kp N        &kp M                &kp COMMA          &kp DOT          &kp SLASH      &none
&kp LCTRL   &kp GLOBE    &kp DELETE                        &num NUM SPACE      &mkp LCLK      &lt SYM ENTER  &sands ARROW SPACE                      &trans         &none       &none
&kp LEFT    &kp UP       &kp SPACE       &kp DOWN          &kp RIGHT                                       &kp HOME             &kp PG_UP          &kp ENTER        &kp PG_DN            &kp END
                                         &trans                                                                                 &trans
            >;

            sensor-bindings = <&enc_cursor>, <&inc_dec_kp PG_UP PG_DN>;
        };

        naginata_layer {
            label = "Nagi";
            bindings = <
&kp ESCAPE  &ng Q           &ng W              &ng E               &ng R                 &ng T      &ng Y           &ng U                  &ng I                &ng O              &ng P             &kp LS(LA(LC(F)))
&kp TAB     &ng_mt LCTRL A  &ng_mt LEFT_ALT S  &ng_mt LEFT_SHIFT D  &ng_mt LEFT_COMMAND F  &ng G      &ng H           &ng_mt RIGHT_COMMAND J  &ng_mt RIGHT_SHIFT K  &ng_mt RIGHT_ALT L  &ng_mt RCTRL SEMI  &kp F3
&kp LSHFT   &ng Z           &ng X              &ng C               &ng V                 &ng B      &ng N           &ng M                  &ng COMMA            &ng DOT            &ng SLASH         &none
&kp LCTRL   &kp GLOBE       &kp DELETE                               &ng_num NUM SPACE     &mkp LCLK  &ng_lt SYM ENTER  &ng_sands ARROW SPACE                         &trans             &none          &none
&kp LEFT    &kp UP          &kp SPACE          &kp DOWN             &kp RIGHT                                              &kp HOME                &kp PG_UP            &kp ENTER          &kp PG_DN       &kp END
                                             &trans                                                                                         &trans
            >;

            sensor-bindings = <&enc_cursor>, <&inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            label = "Num";
            bindings = <
&trans    &trans  &kp N1                      &kp N2                  &kp N3                    &kp EQUAL      &space_key Y  &space_key U      &space_key I      &space_key O    &space_key P      &trans
&trans    &trans  &num_mod LEFT_ALT NUMBER_4  &num_mod LEFT_SHIFT N5  &num_mod LEFT_COMMAND N6  &kp N0         &space_key H  &space_key J      &space_key K      &space_key L    &space_key SEMI   &trans
&trans    &trans  &kp N7                      &kp N8                  &kp N9                    &kp DOT        &space_key N  &space_key M      &space_key COMMA  &space_key DOT  &space_key SLASH  &trans
&trans    &trans  &trans                                              &trans                    &trans         &kp ENTER     &lt MATH LANGUAGE_1                 &trans          &trans            &trans
&kp LEFT  &kp UP  &kp SPACE                   &kp DOWN                &kp RIGHT                                              &kp HOME          &kp PG_UP         &kp ENTER       &kp PG_DN         &kp END
                                              &trans                                                                                           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        naginata_num_layer {
            label = "NagiNum";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &ng_space_key Y  &ng_space_key U      &ng_space_key I      &ng_space_key O    &ng_space_key P      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &ng_space_key H  &ng_space_key J      &ng_space_key K      &ng_space_key L    &ng_space_key SEMI   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &ng_space_key N  &ng_space_key M      &ng_space_key COMMA  &ng_space_key DOT  &ng_space_key SLASH  &trans
&trans  &trans  &trans                  &trans  &trans  &trans    &trans                                     &trans                &trans                &trans
&trans  &trans  &trans  &trans  &trans                          &trans            &trans                &trans               &trans  &trans
                        &trans                                                     &trans
            >;
        };

        math {
            bindings = <
&trans  &trans  &kp N1                      &kp N2                        &kp N3                          &kp EQUAL      &trans  &kp PERCENT  &deg       &kp CARET     &kp DOLLAR     &trans
&trans  &trans  &num_mod LEFT_ALT NUMBER_4  &num_mod LEFT_SHIFT NUMBER_5  &num_mod LEFT_COMMAND NUMBER_6  &kp N0         &trans  &kp PLUS     &kp MINUS  &kp ASTERISK  &kp FSLH       &trans
&trans  &trans  &kp N7                      &kp N8                        &kp N9                          &kp DOT        &trans  &kp AT       &kp UNDER  &kp SEMI      &kp BACKSLASH  &trans
&trans  &trans  &trans                                                    &trans                          &trans         &trans  &trans                  &trans        &trans         &trans
&trans  &trans  &trans                      &trans                        &trans                                                 &trans       &trans     &trans        &trans         &trans
                                            &trans                                                                                            &trans
            >;

            label = "MT";
        };

        symbol-arrow {
            bindings = <
&trans  &kp AMPERSAND      &kp NON_US_BACKSLASH  &kp TILDE        &kp UNDERSCORE  &trans      &trans  &kp LG(DELETE)        &trans                 &trans  &trans  &trans
&trans  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE      &kp EXCLAMATION  &kp QUESTION    &trans      &trans  &trans                &trans                 &trans  &trans  &trans
&trans  &kakko4            &kakko3               &kakko2          &kakko1         &trans      &trans  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &trans  &trans  &trans
&trans  &trans             &trans                                 &trans          &trans      &trans  &trans                                       &trans  &trans  &trans
&trans  &trans             &trans                &trans           &trans                              &trans                &trans                 &trans  &trans  &trans
                                                 &trans                                                                     &trans
            >;

            label = "SYM";
            sensor-bindings = <&enc_app>, <&inc_dec_kp PG_UP PG_DN>;
        };

        arrow {
            bindings = <
&trans        &trans        &trans          &trans  &trans          &trans      &trans  &trans    &kp UP    &trans     &trans  &trans
&trans        &trans        &trans          &trans  &trans          &trans      &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans        &trans        &trans          &trans  &trans          &trans      &trans  &trans    &trans    &trans     &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_CLR_ALL          &kp LANGUAGE_2  &trans      &trans  &trans              &trans     &trans  &trans
&trans        &trans        &trans          &trans  &trans                              &trans    &trans    &trans     &trans  &trans
                                            &trans                                                &trans
            >;

            label = "arr";
        };
    };
};
