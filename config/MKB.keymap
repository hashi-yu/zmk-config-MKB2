// #include <layout_shift.dtsi>

#include <layout_shift_kp_override.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define NUM 1
#define MATH 2
#define SYM 3
#define SYM2 4
#define BT 5

&lt {
    quick-tap-ms = <150>;
    flavor = "tap-preferred";
};

&mt {
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    flavor = "tap-preferred";
};

/ {
    macros {
        deg: deg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp LS(LA(N8)) &kp LS(C)>;
            label = "DEG";
        };

        kakko1: kakko1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS>;
            label = "KAKKO1";
        };

        kakko2: kakko2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LESS_THAN &kp GREATER_THAN>;
            label = "KAKKO2";
        };

        kakko3: kakko3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET>;
            label = "KAKKO3";
        };

        kakko4: kakko4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE>;
            label = "KAKKO4";
        };

        space_key: space_key {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp SPACE &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp SPACE>;

            label = "SPACE_KEY";
        };
    };

    behaviors {
        to_num: to_num {
            compatible = "zmk,behavior-hold-tap";
            label = "TO_NUM";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 11 23 35 45 43 44 42 41>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        to_arr: to_arr {
            compatible = "zmk,behavior-hold-tap";
            label = "TO_ARR";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 45 44 43 40 39 0 12 24 36 38 37>;
        };

        lang1_mt2: lang1_mt2 {
            compatible = "zmk,behavior-hold-tap";
            label = "LANG1_MT2";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            hold-while-undecided;
            retro-tap;
        };

        num_mod: num_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "NUM_MOD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <14 15 16>;
        };

        sensor_none: sensor_none {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&none>, <&none>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Def";
            bindings = <
&kp ESCAPE  &kp Q        &kp W           &kp E             &kp R               &kp T          &kp Y        &kp BACKSPACE        &kp I              &kp O            &kp P        &kp LS(LA(LC(F)))
&kp TAB     &mt LCTRL A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LEFT_COMMAND F  &kp G          &kp H        &mt RIGHT_COMMAND J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &mt RCTRL U  &kp F3
&kp LSHFT   &kp Z        &kp X           &kp C             &kp V               &kp B          &kp N        &kp M                &kp COMMA          &kp DOT          &kp SLASH    &trans
&trans      &trans       &trans                            &to_num 1 SPACE     &mkp LCLK      &lt 4 ENTER  &to_arr 2 SPACE                         &trans           &trans       &trans
&kp LEFT    &kp UP       &kp SPACE       &kp DOWN          &kp RIGHT                                       &kp HOME             &kp PG_UP          &kp ENTER        &kp PG_DN    &kp END
                                         &trans                                                                                 &trans
            >;

            sensor-bindings = <&sensor_none>, <&inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            label = "Num";
            bindings = <
&trans    &trans  &kp N1     &kp N2    &kp N3     &kp EQUAL      &trans     &trans                   &trans     &trans     &trans     &trans
&trans    &trans  &kp N4     &kp N5    &kp N6     &kp N0         &trans     &trans                   &trans     &trans     &trans     &trans
&trans    &trans  &kp N7     &kp N8    &kp N9     &kp DOT        &trans     &trans                   &trans     &trans     &trans     &trans
&trans    &trans  &trans               &trans     &trans         &kp ENTER  &lang1_mt2 3 LANGUAGE_1             &trans     &trans     &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                            &kp HOME                 &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                             &trans                                                                  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        arrow {
            bindings = <
&trans        &trans        &trans          &trans  &trans          &trans      &trans  &trans    &kp UP    &trans     &trans  &trans
&trans        &trans        &trans          &trans  &trans          &trans      &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans        &trans        &trans          &trans  &trans          &trans      &trans  &trans    &trans    &trans     &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_CLR_ALL          &kp LANGUAGE_2  &trans      &trans  &trans              &trans     &trans  &trans
&trans        &trans        &trans          &trans  &trans                              &trans    &trans    &trans     &trans  &trans
                                            &trans                                                &trans
            >;

            label = "arr";
        };

        mt2 {
            label = "MT2";
            bindings = <
&trans  &trans  &kp N1  &kp N2  &kp N3  &kp EQUAL      &trans  &kp PERCENT  &deg       &kp CARET  &kp TILDE      &trans
&trans  &trans  &kp N4  &kp N5  &kp N6  &kp N0         &trans  &kp AT       &kp UNDER  &kp PIPE   &kp BACKSLASH  &trans
&trans  &trans  &kp N7  &kp N8  &kp N9  &kp DOT        &trans  &kp PLUS     &kp MINUS  &kp ASTRK  &kp SLASH      &trans
&trans  &trans  &trans          &trans  &trans         &trans  &trans                  &trans     &trans         &trans
&trans  &trans  &trans  &trans  &trans                         &trans       &trans     &trans     &trans         &trans
                        &trans                                              &trans
            >;
        };

        symbol-arrow {
            bindings = <
&trans  &kp LESS_THAN     &kp LEFT_BRACKET   &kp LEFT_BRACE   &kp LPAR               &trans      &trans  &kp SEMI              &kp COLON              &trans            &trans             &trans
&trans  &kakko2           &kakko3            &kakko4          &kakko1                &trans      &trans  &kp QUESTION          &kp EXCL               &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &trans
&trans  &kp GREATER_THAN  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &trans      &trans  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &trans            &trans             &trans
&trans  &trans            &trans                              &trans                 &trans      &trans  &trans                                       &trans            &trans             &trans
&trans  &trans            &trans             &trans           &trans                                     &trans                &trans                 &trans            &trans             &trans
                                             &trans                                                                            &trans
            >;

            label = "SYM";
            sensor-bindings = <&sensor_none>, <&inc_dec_kp PG_UP PG_DN>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
